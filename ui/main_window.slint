import { Button, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {

    width: 400px;
    height: 600px;

    in property <int> cpu_cores: 0;
    in property <int> cpu_usage: 0;
    in property <[int]> cores_usage: [];
    in property <int> ram_total: 0;

    callback update_cpu_usage();

    Timer {
        interval: 1s;
        triggered => {
            root.update_cpu_usage();
        }
    }

    VerticalLayout {
        x: 10px;
        y: 10px;

        Text {
            text: "Physical CPU cores: " + root.cpu_cores;
            font-size: 16px;
        }

        Text {
            text: "CPU Usage: " + root.cpu_usage + "%";
            font-size: 16px;
        }

        for usage[i] in root.cores_usage: Text {
            text: "Core " + (i + 1) + ": " + usage + "%";
            font-size: 16px;
        }

        Text {
            text: "Total RAM: " + root.ram_total;
            font-size: 16px;
        }
    }
}
