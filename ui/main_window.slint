import { Button, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {

    width: 400px;
    height: 400px;

    in-out property <int> cpu_usage: 0;
    in property <int> cpu_cores: 0;
    in property <int> ram_total: 0;

    callback print_cpu_usage() -> int;

    Timer {
        interval: 1s;
        running: true;
        triggered => {
            root.cpu_usage = root.print_cpu_usage();
        }
    }

    Text {
        x: 10px;
        y: 10px;
        text: "CPU Usage: " + root.cpu_usage + "%";
        font-size: 20px;
    }

    Text {
        x: 10px;
        y: 40px;
        text: "Physical cores: " + root.cpu_cores;
        font-size: 20px;
    }

    Text {
        x: 10px;
        y: 70px;
        text: "Memory: " + root.ram_total;
        font-size: 20px; 
    }
}